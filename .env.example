# ─── Breezyair Agents (LLM) ─────────────────────────────────────────
# ONE key switches the chatbot on. The recommended path is the Vercel AI
# Gateway — a single key that routes to OPEN-SOURCE models (no Claude key needed).
# On Vercel this is provided automatically via OIDC; locally, create a key at
# https://vercel.com/dashboard → AI Gateway.
AI_GATEWAY_API_KEY=

# Default model is the open-weight moonshotai/kimi-k2. Override with BREEZY_MODEL.
# Strong open alternatives: deepseek/deepseek-v3.1, zai/glm-4.6, minimax/minimax-m2.
# Verify slugs: curl -s https://ai-gateway.vercel.sh/v1/models | jq -r '.data[].id'
# BREEZY_MODEL=moonshotai/kimi-k2

# Alternative: talk to a provider DIRECTLY instead of the gateway (pick ONE).
# The resolver in lib/agent/model.ts auto-detects whichever key is set.
# KIMI_API_KEY=            # Moonshot / Kimi   (api.moonshot.cn)
# MINIMAX_API_KEY=         # MiniMax           (api.minimax.chat)
# DEEPSEEK_API_KEY=        # DeepSeek          (api.deepseek.com)
# OPENAI_API_KEY=          # any OpenAI-compatible endpoint
# OPENAI_BASE_URL=         # ↑ custom base URL for the above
# GOOGLE_GENERATIVE_AI_API_KEY=   # Google Gemini

# ─── OPEN NODES (leave blank until connected) ───────────────────────
# Notion CRM (adapters/crm.ts)
NOTION_TOKEN=
NOTION_LEADS_DB=
NOTION_APPOINTMENTS_DB=
NOTION_AMC_DB=            # AMC Contracts DB — enables renewal tracking + reminders
NOTION_TECHNICIANS_DB=

# WhatsApp — Meta Cloud API (adapters/notify.ts). See WHATSAPP_SETUP.md.
# Blank WHATSAPP_TOKEN → safe stub (logs only).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Business-initiated messages need an APPROVED single-parameter ({{1}}) template:
WHATSAPP_CONFIRM_TEMPLATE=    # customer booking confirmation template name
WHATSAPP_ALERT_TEMPLATE=      # Asad urgent-alert template name
# WHATSAPP_TEMPLATE_LANG=en   # template language code (default en)
# WHATSAPP_API_VERSION=v21.0  # Graph API version (default v21.0)
ASAD_ESCALATION_PHONE=+918660174569

# Voice provider (adapters/voice.ts) — Vapi / Retell / ElevenLabs / Twilio
VOICE_PROVIDER=

# Outbound DND/NCPR compliance (care/compliance.ts)
DND_PROVIDER=

# Protects the Breezy Care cron route (/api/agent/care/run)
CRON_SECRET=

# Payments — Razorpay (api/payment/*). Blank → pay button returns 503 (booking still works).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Google Search Console verification token (layout.tsx)
GOOGLE_SITE_VERIFICATION=

# ─── Sanity CMS (blog) ──────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
