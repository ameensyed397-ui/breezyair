# ─── Breezyair Agents ───────────────────────────────────────────────
# LLM via Vercel AI Gateway. Required to switch the agents on.
# On Vercel this is provided automatically; locally, create a key.
AI_GATEWAY_API_KEY=

# Optional: override the model (default anthropic/claude-sonnet-4-6).
# List available: curl -s https://ai-gateway.vercel.sh/v1/models | jq -r '.data[].id'
# BREEZY_MODEL=anthropic/claude-sonnet-4-6

# ─── OPEN NODES (leave blank until connected) ───────────────────────
# Notion CRM (adapters/crm.ts)
NOTION_TOKEN=
NOTION_LEADS_DB=
NOTION_APPOINTMENTS_DB=
NOTION_TECHNICIANS_DB=

# WhatsApp / escalation (adapters/notify.ts)
WHATSAPP_TOKEN=
ASAD_ESCALATION_PHONE=+918660174569

# Voice provider (adapters/voice.ts) — Vapi / Retell / ElevenLabs / Twilio
VOICE_PROVIDER=

# Outbound DND/NCPR compliance (care/compliance.ts)
DND_PROVIDER=

# Protects the Breezy Care cron route (/api/agent/care/run)
CRON_SECRET=
